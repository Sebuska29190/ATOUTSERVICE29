{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "atoutservice29",
  "main": "worker.js",
  "compatibility_date": "2026-09-29",
  "workers_dev": true,
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "send_email": [
    {
      "name": "EMAIL"
    }
  ]
}
